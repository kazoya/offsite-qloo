# Qloo hackathon key: request via the form linked from https://qloo.devpost.com/
# The key only works against the hackathon base URL below.
QLOO_API_KEY=
QLOO_BASE_URL=https://hackathon.api.qloo.com
# Cache mode for Qloo responses (private, server-side, gitignored): on | off | replay
QLOO_CACHE=on

# Optional LLM (any OpenAI-compatible endpoint). Without these the deterministic
# rule-based provider is used and everything still works.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# Manager demo PIN for approve/reject (required in production, otherwise approvals are disabled)
APPROVALS_PIN=
# Approvals storage: a JSON file path, or "memory" (default on Vercel)
# APPROVALS_FILE=memory
# Qloo response cache directory (use /tmp/qloo-cache on serverless)
# QLOO_CACHE_DIR=
