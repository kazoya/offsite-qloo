flowchart TB
  subgraph Browser["Browser: Next.js UI (/ar RTL, /en)"]
    P["Planner page<br/>demo company (synthetic, 12 people), team tastes,<br/>city, date, start time, budget, threshold"]
    FB["Feedback controls<br/>budget · reject venue · not fair to X ·<br/>manager reject (reason required)"]
    DV["What changed + decision log<br/>diff vs previous / original plan"]
    A["Approvals page<br/>per-visitor demo sandbox (no PIN)"]
  end

  subgraph Server["Next.js server on Vercel (Node, CPU only)"]
    G["Guards: rate limit 10/min plan, 30/min approvals (per instance) ·<br/>body cap · validation · 25 s deadline"]
    API["POST /api/plan { request, feedback[] }"]
    subgraph Loop["Agent loop: runAgent (src/agent/loop.ts)"]
      U["understand"] --> QQ["qloo_queries"] --> RK["rank"] --> BT["budget_time_check"] --> PR["propose"] --> EX["explain"] --> AG["approval_gate"]
      AF["apply_feedback (replan pass)"] --> VF["verify_feedback<br/>met / not met"]
    end
    subgraph Planner["Planner (src/agent/planner.ts)"]
      T["Group taste profile<br/>votes, exact-match artist seeds"]
      R["Score: 0.5 Qloo affinity + 0.25 coverage<br/>+ 0.15 team fit + 0.1 rating"]
      H["Hours, dietary labels, budget estimate"]
      PO["Policy R1 / R2 / R3 + audit log"]
      V["3 diverse options"]
    end
    F["Team Fairness Engine (src/agent/fairness.ts)<br/>per-member coverage, Best fit / Fairest / Cheapest,<br/>who is left out (reports; re-ranks only on 'not fair')"]
    D["Plan diff (src/agent/diff.ts)"]
    N["Narration: rule-based default,<br/>optional OpenAI-compatible LLM (text only)"]
    AP["/api/approvals · /api/approvals/:id"]
    SB[("Sandbox registry<br/>in-memory queue per cookie, 2 h TTL")]
    RU["ReusingQloo: identical calls answered once per run"]
    C[("Private response cache (gitignored / /tmp)")]
  end

  Q["Qloo Hackathon API<br/>GET /search (artists) · GET /v2/insights (places:<br/>tags, location, signals, explainability, hours, price_level)"]

  P -- "plan" --> G --> API --> U
  FB -- "same request + feedback" --> G
  API --> AF
  AF --> U
  QQ --> T --> R --> H --> PO --> V --> F
  QQ <--> RU <--> C <--> Q
  F --> EX --> N
  AG --> VF
  VF --> D --> DV
  AG -- "options over R2: awaiting_human" --> P
  P -- "Send to manager (user click only)" --> AP --> SB
  A <--> AP
