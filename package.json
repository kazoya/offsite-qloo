{
  "name": "offsite-qloo",
  "version": "0.1.0",
  "private": true,
  "description": "Bilingual (Arabic/English) corporate offsite planner agent powered by Qloo taste intelligence",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "next dev -p 3200",
    "build": "next build",
    "start": "next start -p 3200",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "probe": "tsx --env-file=.env scripts/probe-coverage.ts",
    "plan": "tsx --env-file=.env scripts/plan-cli.ts"
  },
  "dependencies": {
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
